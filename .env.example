# One-time setup for the Docker stack (`make up`). Copy this file to .env once,
# fill in the three REQUIRED values, and never touch it again. Docker Compose
# reads .env on every start; `make dev-api` ignores it and reads server/.env.
#
# The REQUIRED values have no default on purpose: the stack refuses to start
# with placeholder secrets. Fill all three in one go:
#
#   cp .env.example .env
#   perl -pi -e "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -base64 48)|;
#                s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -base64 24)|;
#                s|^MINIO_ROOT_PASSWORD=.*|MINIO_ROOT_PASSWORD=$(openssl rand -base64 24)|" .env
#
# Everything under Optional can stay as it is for a local run.

# --- REQUIRED secrets -------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 24
POSTGRES_PASSWORD=
MINIO_ROOT_USER=crypticstorage
# openssl rand -base64 24
MINIO_ROOT_PASSWORD=

# --- Optional ---------------------------------------------------------------
# 32-byte key (hex or base64) that encrypts TOTP secrets at rest. Derived from JWT_SECRET if empty.
SERVER_ENCRYPTION_KEY=
# Public URL of the web app (share links are built from it, CORS allows it).
APP_URL=http://localhost:3000
# Port the web app is published on.
WEB_PORT=3000
# Set to http://localhost:9000 to have browsers upload/download straight to MinIO with presigned URLs.
# Leave empty to stream through the API (simplest; works behind any reverse proxy).
S3_PUBLIC_ENDPOINT=
S3_BUCKET=crypticstorage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_FILE_SIZE_BYTES=5368709120
LOG_LEVEL=info
