# Copy to .env before `docker compose up`. Every value marked REQUIRED has no
# default on purpose: the stack refuses to start with placeholder secrets.

# --- REQUIRED secrets -------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 24
POSTGRES_PASSWORD=
MINIO_ROOT_USER=crypticstorage
# openssl rand -base64 24
MINIO_ROOT_PASSWORD=

# --- Optional ---------------------------------------------------------------
# 32-byte key (hex or base64) that encrypts TOTP secrets at rest. Derived from JWT_SECRET if empty.
SERVER_ENCRYPTION_KEY=
# Public URL of the web app (share links are built from it, CORS allows it).
APP_URL=http://localhost:3000
# Port the web app is published on.
WEB_PORT=3000
# Set to http://localhost:9000 to have browsers upload/download straight to MinIO with presigned URLs.
# Leave empty to stream through the API (simplest; works behind any reverse proxy).
S3_PUBLIC_ENDPOINT=
S3_BUCKET=crypticstorage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_FILE_SIZE_BYTES=5368709120
LOG_LEVEL=info
