# One-time setup for the Docker stack (`make up`). Copy this file to .env once,
# fill in the two REQUIRED values, and never touch it again. Docker Compose
# reads .env on every start; `make dev-api` ignores it and reads server/.env.
#
# The REQUIRED values have no default on purpose: the stack refuses to start
# with placeholder secrets. Fill both in one go:
#
#   cp .env.example .env
#   perl -pi -e "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -base64 48)|;
#                s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#
# Everything under Optional can stay as it is for a local run.

# --- REQUIRED secrets -------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -hex 24  (hex, not base64: this value is spliced into a postgresql:// URL, and / + = would break it)
POSTGRES_PASSWORD=

# --- Optional ---------------------------------------------------------------
# 32-byte key (hex or base64) that encrypts TOTP secrets at rest. Derived from JWT_SECRET if empty.
SERVER_ENCRYPTION_KEY=
# Public URL of the web app (share links are built from it, CORS allows it).
APP_URL=http://localhost:3000
# Port the web app is published on.
WEB_PORT=3000
# Storage. `local` keeps encrypted objects on the storage_data Docker volume and
# streams them through the API; nothing else to configure. For an external
# S3-compatible store (AWS S3, R2, Garage, ...) set STORAGE_DRIVER=s3 and the
# S3_* values; S3_PUBLIC_ENDPOINT (a URL browsers can reach) additionally
# switches uploads and downloads to presigned URLs straight to the store.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crypticstorage
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_FILE_SIZE_BYTES=5368709120
LOG_LEVEL=info

# Mail. `log` prints every email to the API log instead of sending it, which is fine for a local run.
# A real deployment sets MAIL_DRIVER=smtp with SMTP_URL (smtp://user:pass@host:587 or smtps://) and MAIL_FROM.
MAIL_DRIVER=log
SMTP_URL=
MAIL_FROM=

# Witness set size bounds for handoff (the threshold is always between 2 and n).
WITNESS_MIN_N=2
WITNESS_MAX_N=7
# A witness may also be named as a recipient. Set to false to forbid the overlap.
WITNESS_MAY_BE_RECIPIENT=true
