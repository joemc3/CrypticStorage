# One-time setup for local dev without Docker. Copy this file to server/.env
# once, fill in the two values below, and never touch it again. `make dev-api`
# reads server/.env on every start; the Docker stack ignores it and reads the
# root .env.
#
# Only two values need setting:
#   JWT_SECRET    at least 32 characters
#   DATABASE_URL  whatever `make dev-db` prints (port 54321, not the 5432 below)
#
#   cp server/.env.example server/.env
#   perl -pi -e "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -base64 48)|;
#                s|^DATABASE_URL=.*|DATABASE_URL=postgresql://postgres:postgres\@127.0.0.1:54321/crypticstorage|" server/.env
#
# Everything else can stay as it is: STORAGE_DRIVER=local keeps files on disk
# and needs no S3 values. The client needs no env file.

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Set to true when running behind nginx or another reverse proxy
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://crypticstorage:crypticstorage@localhost:5432/crypticstorage

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional 32-byte key (hex or base64) that encrypts TOTP secrets at rest. Derived from JWT_SECRET if unset.
SERVER_ENCRYPTION_KEY=

# --- URLs ---
APP_URL=http://localhost:3000
# Leave empty when the web app proxies /api to this server (same origin).
API_PUBLIC_URL=
# Extra allowed origins, comma separated
CORS_ORIGINS=

# --- Storage ---
# local: files on disk under STORAGE_LOCAL_PATH (dev, tests, single node)
# s3:    any S3-compatible store (MinIO, AWS S3, R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crypticstorage
S3_REGION=us-east-1
# Endpoint browsers can reach. When set, uploads/downloads use presigned URLs straight to S3.
S3_PUBLIC_ENDPOINT=

# --- Limits ---
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_FILE_SIZE_BYTES=5368709120
PENDING_UPLOAD_TTL_HOURS=24
