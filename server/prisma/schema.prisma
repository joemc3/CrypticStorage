// CrypticStorage database schema.
//
// The server only ever stores ciphertext and wrapped keys. Every column whose
// name starts with "encrypted" or "wrapped" is opaque to the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  /// bcrypt hash of the client-derived authentication key (never the password).
  passwordHash           String    @map("password_hash")
  /// Base64 salt used by the client KDF. Public, not secret.
  salt                   String
  kdfIterations          Int       @default(600000) @map("kdf_iterations")
  /// Master key wrapped with the password-derived wrapping key (client JSON blob).
  wrappedMasterKey       String    @map("wrapped_master_key")
  /// RSA-OAEP public key (base64 SPKI) used by other users to share file keys.
  publicKey              String    @map("public_key")
  /// RSA private key encrypted with the master key (client JSON blob).
  encryptedPrivateKey    String    @map("encrypted_private_key")
  storageQuota           BigInt    @default(10737418240) @map("storage_quota")
  storageUsed            BigInt    @default(0) @map("storage_used")
  twoFactorEnabled       Boolean   @default(false) @map("two_factor_enabled")
  /// Active TOTP secret, encrypted at rest with the server key.
  totpSecretEnc          String?   @map("totp_secret_enc")
  /// TOTP secret awaiting first successful verification.
  totpPendingEnc         String?   @map("totp_pending_enc")
  backupCodeHashes       String[]  @default([]) @map("backup_code_hashes")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  lastLoginAt            DateTime? @map("last_login_at")
  /// Server-visible, not secret. Shown wherever the design says {name}, else the email.
  displayName            String?   @map("display_name") @db.VarChar(64)
  /// Null until the verification link is used.
  emailVerifiedAt        DateTime? @map("email_verified_at")
  contractAcknowledgedAt DateTime  @default(now()) @map("contract_acknowledged_at")
  lockAfterMinutes       Int       @default(5) @map("lock_after_minutes")
  lastActivityAt         DateTime  @default(now()) @map("last_activity_at")
  /// How many witnesses must agree to release (k of n). Never below 2.
  witnessThreshold       Int       @default(2) @map("witness_threshold")

  files          File[]
  folders        Folder[]
  sessions       Session[]
  auditLogs      AuditLog[]
  shareLinks     ShareLink[]
  sharesGiven    FileShare[]  @relation("SharesGiven")
  sharesReceived FileShare[]  @relation("SharesReceived")
  emailTokens    EmailToken[]

  witnesses       Witness[]    @relation("WitnessOwner")
  witnessFor      Witness[]    @relation("WitnessUser")
  trustedKeys     TrustedKey[] @relation("TrustOwner")
  trustedByOthers TrustedKey[] @relation("TrustContact")

  handoffRules       HandoffRule[]          @relation("RuleOwner")
  handoffAsRecipient HandoffRuleRecipient[]
  handoffAsWitness   HandoffRuleShare[]

  requestsAboutMe ReleaseRequest[]   @relation("RequestOwner")
  requestsOpened  ReleaseRequest[]   @relation("RequestOpener")
  votesCast       ReleaseVote[]
  voteSharesGiven ReleaseVoteShare[] @relation("VoteShareWitness")
  voteSharesForMe ReleaseVoteShare[] @relation("VoteShareRecipient")

  @@map("users")
}

model Folder {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  parentId        String?  @map("parent_id")
  /// Folder name encrypted with the owner's master key.
  encryptedName   String   @map("encrypted_name")
  encryptedNameIv String   @map("encrypted_name_iv")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files    File[]

  handoffRules HandoffRule[]

  @@index([userId, parentId])
  @@map("folders")
}

enum FileStatus {
  PENDING
  READY
}

model File {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  folderId         String?    @map("folder_id")
  /// File name encrypted with the per-file key, so anyone holding the file key can read it.
  encryptedName    String     @map("encrypted_name")
  encryptedNameIv  String     @map("encrypted_name_iv")
  /// Per-file AES key wrapped with the owner's master key.
  encryptedFileKey String     @map("encrypted_file_key")
  fileKeyIv        String     @map("file_key_iv")
  /// Base nonce for the chunked AES-GCM content encryption.
  contentIv        String     @map("content_iv")
  /// Size of the ciphertext in bytes, as declared by the client and verified on confirm.
  encryptedSize    BigInt     @map("encrypted_size")
  mimeType         String     @default("application/octet-stream") @map("mime_type")
  storageKey       String     @unique @map("storage_key")
  status           FileStatus @default(PENDING)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]
  shares     FileShare[]

  handoffRules HandoffRule[]
  handoffItems HandoffRuleItem[]

  @@index([userId, folderId, status])
  @@map("files")
}

/// Anonymous share link. The file key travels in the URL fragment and never reaches the server.
model ShareLink {
  id             String    @id @default(uuid())
  token          String    @unique
  fileId         String    @map("file_id")
  ownerId        String    @map("owner_id")
  passwordHash   String?   @map("password_hash")
  expiresAt      DateTime? @map("expires_at")
  maxDownloads   Int?      @map("max_downloads")
  downloadCount  Int       @default(0) @map("download_count")
  revokedAt      DateTime? @map("revoked_at")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  file  File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("share_links")
}

/// User-to-user share. The file key is wrapped with the recipient's RSA public key.
model FileShare {
  id               String    @id @default(uuid())
  fileId           String    @map("file_id")
  ownerId          String    @map("owner_id")
  recipientId      String    @map("recipient_id")
  encryptedFileKey String    @map("encrypted_file_key")
  permissions      String    @default("read")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  owner     User @relation("SharesGiven", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User @relation("SharesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([fileId, recipientId])
  @@index([recipientId])
  @@map("file_shares")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  success      Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum EmailTokenPurpose {
  verify_email
  check_in
}

model EmailToken {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  purpose   EmailTokenPurpose
  /// SHA-256 hex of a 32-byte random token. The token itself is only ever in the email.
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

enum WitnessStatus {
  invited
  accepted
  declined
  removed
}

/// A person the owner named to help release their items. Holds no data, only a duty.
model Witness {
  id            String        @id @default(uuid())
  ownerId       String        @map("owner_id")
  witnessUserId String        @map("witness_user_id")
  status        WitnessStatus @default(invited)
  invitedAt     DateTime      @default(now()) @map("invited_at")
  respondedAt   DateTime?     @map("responded_at")

  owner   User @relation("WitnessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  witness User @relation("WitnessUser", fields: [witnessUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, witnessUserId])
  @@index([witnessUserId, status])
  @@map("witnesses")
}

/// Trust on first use: the key fingerprint a user last saw for a contact. Public data only.
model TrustedKey {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  contactUserId    String   @map("contact_user_id")
  /// SHA-256 of the SPKI bytes, lowercase hex.
  fingerprint      String
  verifiedInPerson Boolean  @default(false) @map("verified_in_person")
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")

  user    User @relation("TrustOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("TrustContact", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId])
  @@map("trusted_keys")
}

enum HandoffRuleState {
  active
  warning
  released_timer
  released_quorum
  revoked
}

/// A rule that releases a file or a folder to named recipients. Exactly one of file_id and folder_id is set
/// (checked in the service and by a CHECK constraint in the migration).
model HandoffRule {
  id                     String           @id @default(uuid())
  ownerId                String           @map("owner_id")
  fileId                 String?          @map("file_id")
  folderId               String?          @map("folder_id")
  periodDays             Int              @map("period_days")
  state                  HandoffRuleState @default(active)
  /// Release key wrapped under the owner's master key (client JSON blob).
  wrappedReleaseKeyOwner String           @map("wrapped_release_key_owner")
  /// The witness set changed since the shares were made; the owner's client re-splits at next unlock.
  sharesStale            Boolean          @default(false) @map("shares_stale")
  createdAt              DateTime         @default(now()) @map("created_at")
  reminded75At           DateTime?        @map("reminded_75_at")
  reminded90At           DateTime?        @map("reminded_90_at")
  reminded95At           DateTime?        @map("reminded_95_at")
  releasedAt             DateTime?        @map("released_at")
  revokedAt              DateTime?        @map("revoked_at")
  /// The release request whose vote shares open this rule. Only its shares are served to recipients.
  releasedByRequestId    String?          @map("released_by_request_id")

  owner      User                   @relation("RuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  file       File?                  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder     Folder?                @relation(fields: [folderId], references: [id], onDelete: Cascade)
  recipients HandoffRuleRecipient[]
  items      HandoffRuleItem[]
  shares     HandoffRuleShare[]
  voteShares ReleaseVoteShare[]

  @@index([ownerId, state])
  @@map("handoff_rules")
}

model HandoffRuleRecipient {
  ruleId            String    @map("rule_id")
  userId            String    @map("user_id")
  /// Release key wrapped under the recipient's RSA public key (base64).
  wrappedReleaseKey String    @map("wrapped_release_key")
  notifiedAt        DateTime? @map("notified_at")

  rule HandoffRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ruleId, userId])
  @@index([userId])
  @@map("handoff_rule_recipients")
}

model HandoffRuleItem {
  ruleId         String @map("rule_id")
  fileId         String @map("file_id")
  /// File key wrapped under the rule's release key (client JSON blob).
  wrappedFileKey String @map("wrapped_file_key")

  rule HandoffRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  file File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([ruleId, fileId])
  @@index([fileId])
  @@map("handoff_rule_items")
}

model HandoffRuleShare {
  ruleId        String @map("rule_id")
  witnessUserId String @map("witness_user_id")
  /// Shamir share wrapped under the witness's RSA public key (base64).
  wrappedShare  String @map("wrapped_share")
  shareIndex    Int    @map("share_index")

  rule    HandoffRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  witness User        @relation(fields: [witnessUserId], references: [id], onDelete: Cascade)

  @@id([ruleId, witnessUserId])
  @@map("handoff_rule_shares")
}

enum ReleaseRequestState {
  open
  cancelled
  completed
}

/// A witness asked to release an owner's items. At most one is open per owner (partial unique index in the migration).
model ReleaseRequest {
  id             String              @id @default(uuid())
  ownerId        String              @map("owner_id")
  openedByUserId String              @map("opened_by_user_id")
  state          ReleaseRequestState @default(open)
  /// The owner's threshold when the request opened. Rules do not record the k their shares were split with, so the request fixes it.
  requiredVotes  Int                 @map("required_votes")
  openedAt       DateTime            @default(now()) @map("opened_at")
  closedAt       DateTime?           @map("closed_at")
  /// Why a cancelled request closed: owner_activity (the owner was seen), owner_change or no_release_possible.
  reason         String?

  owner    User               @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  openedBy User               @relation("RequestOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)
  votes    ReleaseVote[]
  shares   ReleaseVoteShare[]

  @@index([ownerId, state])
  @@map("release_requests")
}

model ReleaseVote {
  requestId     String   @map("request_id")
  witnessUserId String   @map("witness_user_id")
  votedAt       DateTime @default(now()) @map("voted_at")

  request ReleaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  witness User           @relation(fields: [witnessUserId], references: [id], onDelete: Cascade)

  @@id([requestId, witnessUserId])
  @@map("release_votes")
}

/// A witness's share for one rule, re-wrapped under one recipient's public key. Opaque to the server.
model ReleaseVoteShare {
  requestId       String @map("request_id")
  witnessUserId   String @map("witness_user_id")
  ruleId          String @map("rule_id")
  recipientUserId String @map("recipient_user_id")
  wrappedShare    String @map("wrapped_share")

  request   ReleaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  witness   User           @relation("VoteShareWitness", fields: [witnessUserId], references: [id], onDelete: Cascade)
  rule      HandoffRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recipient User           @relation("VoteShareRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@id([requestId, witnessUserId, ruleId, recipientUserId])
  @@index([recipientUserId])
  @@map("release_vote_shares")
}
