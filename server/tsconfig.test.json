{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "tests/api/**/*", "tests/lib/**/*", "tests/helpers/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/controllers",
    "src/routes",
    "src/services",
    "src/utils",
    "src/config/database.ts",
    "src/config/redis.ts",
    "src/config/storage.ts",
    "src/middleware/*.middleware.ts",
    "src/middleware/index.ts"
  ]
}
